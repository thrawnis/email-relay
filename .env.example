# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# ---- Admin UI ----------------------------------------------------------------
ADMIN_PASSWORD=change-me
# Signs the admin session cookie. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- Sending identity --------------------------------------------------------
MAIL_FROM=notify@example.com
MAIL_FROM_NAME=Example Co
# Addresses apps may send as (comma separated; user@domain or *@domain). Defaults to MAIL_FROM.
MAIL_ALLOWED_FROM=notify@example.com

# ---- Delivery backend --------------------------------------------------------
# smtp    = real delivery via the SMTP settings below
# console = print messages to the container log instead of sending (testing)
MAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (usually port 587) | ssl (usually port 465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=notify@example.com
SMTP_PASSWORD=
SMTP_TIMEOUT=30
# Only if your SMTP server uses a self-signed/private CA: put the CA cert in ./data and point here.
# Certificates are always verified; this just adds a trusted CA.
SMTP_CA_FILE=

# ---- Queue / retries ---------------------------------------------------------
MAX_ATTEMPTS=5
# Delay before retry N (seconds); the last value repeats
RETRY_SCHEDULE_SECONDS=30,120,600,1800,3600
SEND_CONCURRENCY=2

# ---- Limits / housekeeping ---------------------------------------------------
MAX_RECIPIENTS=50
MAX_ATTACHMENT_BYTES=10485760
# Delete log entries older than N days. 0 = keep forever (default)
LOG_RETENTION_DAYS=0

# ---- How apps reach the relay ------------------------------------------------
# Hostname apps use for the HTTPS API. Resolves to the NPM server; NPM proxies to this host.
PUBLIC_HOSTNAME=emailrelay.example.com
# Hostname SMTP-only apps connect to. Must resolve (local DNS) to THIS host, since NPM can't proxy SMTP.
SUBMISSION_HOSTNAME=smtp.emailrelay.example.com

# ---- Ports on this host --------------------------------------------------------
# LAN IP of this host to publish on (0.0.0.0 = all interfaces)
RELAY_HOST_BIND=0.0.0.0
# HTTPS port NPM forwards to (https://<this-host>:8443)
RELAY_HTTPS_PORT=8443
# The relay only runs over HTTPS: there is no plain-HTTP port and no setting to turn TLS off.

# ---- SMTP submission (for apps that only support SMTP) -----------------------
# Apps log in with username = app name, password = the app's relay key. TLS + AUTH required.
SUBMISSION_ENABLED=true
SUBMISSION_STARTTLS_PORT=587
SUBMISSION_TLS_PORT=465
# UNENCRYPTED SMTP port, for apps that cannot use TLS. Only API keys with "Allow unencrypted SMTP"
# enabled (off by default, set per key in the admin UI) can log in on it. Their key and mail travel
# in clear text, so keep it to a trusted network. To turn the port off, set 0 AND delete its line in docker-compose.yml.
SUBMISSION_PLAIN_PORT=2525

# ---- TLS certificate (HTTPS port + SMTP submission) --------------------------
# Leave empty to auto-generate a self-signed cert in ./data/tls covering both hostnames
# (fine for the NPM -> relay hop; SMTP apps would need to trust it or skip verification).
# For a trusted cert, copy a Let's Encrypt cert from the NPM server into ./data/certs/ (see README):
TLS_CERT=
TLS_KEY=
# e.g. TLS_CERT=/data/certs/fullchain.pem
#      TLS_KEY=/data/certs/privkey.pem

# ---- Reverse proxy -------------------------------------------------------------
# Read client IP and scheme from proxy headers (X-Real-IP, X-Forwarded-Proto, CF-Connecting-IP)
TRUST_PROXY=true
# Only believe those headers from these IPs/CIDRs: the NPM server and the cloudflared host.
# Empty = from anyone who can reach the port (not recommended now that the port is on the LAN).
TRUSTED_PROXIES=
# The send API is LAN-only: refuse /api/* requests that came in through Cloudflare Tunnel
BLOCK_API_VIA_CLOUDFLARE=true
