# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# ---- Admin UI ----------------------------------------------------------------
ADMIN_PASSWORD=change-me
# Signs the admin session cookie. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Admin cookie only sent over HTTPS. Keep true behind Nginx Proxy Manager / Cloudflare Tunnel.
COOKIE_SECURE=true

# ---- Sending identity --------------------------------------------------------
MAIL_FROM=notify@thetruesource.com
MAIL_FROM_NAME=The True Source
# Addresses apps may send as (comma separated; user@domain or *@domain). Defaults to MAIL_FROM.
MAIL_ALLOWED_FROM=notify@thetruesource.com

# ---- Delivery backend --------------------------------------------------------
# smtp    = real delivery via the SMTP settings below
# console = print messages to the container log instead of sending (testing)
MAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (usually port 587) | ssl (usually port 465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=notify@thetruesource.com
SMTP_PASSWORD=
SMTP_TIMEOUT=30
# Only if your SMTP server uses a self-signed/private CA: put the CA cert in ./data and point here.
# Certificates are always verified; this just adds a trusted CA.
SMTP_CA_FILE=

# ---- Queue / retries ---------------------------------------------------------
MAX_ATTEMPTS=5
# Delay before retry N (seconds); the last value repeats
RETRY_SCHEDULE_SECONDS=30,120,600,1800,3600
SEND_CONCURRENCY=2

# ---- Limits / housekeeping ---------------------------------------------------
MAX_RECIPIENTS=50
MAX_ATTACHMENT_BYTES=10485760
# Delete log entries older than N days. 0 = keep forever (default)
LOG_RETENTION_DAYS=0

# ---- Reverse proxy / HTTPS ---------------------------------------------------
# Docker network shared with Nginx Proxy Manager (and cloudflared). Find it with: docker network ls
PROXY_NETWORK=nginx-proxy-manager_default
# Read client IP and scheme from proxy headers (X-Real-IP, X-Forwarded-Proto, CF-Connecting-IP)
TRUST_PROXY=true
# Refuse anything that did not reach the proxy over HTTPS (also sends HSTS)
REQUIRE_HTTPS=true
# The send API is LAN-only: refuse /api/* requests that came in through Cloudflare Tunnel
BLOCK_API_VIA_CLOUDFLARE=true
